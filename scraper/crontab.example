# Refresh Mandalay every 15 minutes, matching the hosted schedule and page notice.
# Edit the path, then install with: crontab scraper/crontab.example
# One failing spider does not stop the others. This command can later move to
# Celery beat or Prefect without changing the spiders.
7,22,37,52 * * * * cd /ABSOLUTE/PATH/Court\ Booker && COURSES_YAML=scraper/courses.mandalay.yaml .venv/bin/python -m golf_scraper.run_all
