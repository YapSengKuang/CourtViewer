# Cloudflare Pages build variables: public project URL and public publishable key only.
# Never use a service-role/secret key here. Leave BOTH unset for local FastAPI mode.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY

# Local development fallback (ignored when either Supabase variable is set).
NEXT_PUBLIC_API_URL=http://localhost:8000
